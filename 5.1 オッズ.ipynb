   "source": [
    "def odds(p):\n",
    "    \"\"\"Computes the odds of a probability.\"\"\"\n",
    "    return p / (1 - p)\n",
    "\n",
    "def probability(o):\n",
    "    \"\"\"Computes the probability of odds.\"\"\"\n",
    "    return o / (1 + o)\n",
    "\n",
    "def probability2(yes, no):\n",
    "    \"\"\"Computes the probability of yes and no.\"\"\"\n",
    "    return yes / (yes + no)"
